---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { sitePath } from "@/lib/urls";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  chrome?: boolean;
}

const {
  title,
  description,
  image = "/social-card.svg",
  article = false,
  chrome = true,
} = Astro.props;
const pageTitle = title === "Lianne Liu" ? title : `${title} — Lianne Liu`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(sitePath(image), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efe3" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Lianne Liu — Writing"
      href={sitePath("/rss.xml")}
    />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ "os-body": !chrome }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {chrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>

---
import { sitePath } from "@/lib/urls";

const navigation = [
  { href: "/work/", label: "Work" },
  { href: "/writing/", label: "Writing" },
  { href: "/about/", label: "About" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath.startsWith(sitePath(href));
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={sitePath()} aria-label="Lianne Liu, home">
      <span aria-hidden="true">LL</span>
      <span>Lianne Liu</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        navigation.map((item) => (
          <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
      <a class="nav-contact" href={sitePath("/contact/")}>Let&rsquo;s talk <span aria-hidden="true">↗</span></a>
    </nav>

    <details class="mobile-menu">
      <summary><span>Menu</span><span aria-hidden="true">＋</span></summary>
      <nav aria-label="Mobile navigation">
        {
          navigation.map((item) => (
            <a href={sitePath(item.href)} aria-current={isCurrent(item.href) ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
        <a href={sitePath("/contact/")}>Contact</a>
      </nav>
    </details>
  </div>
</header>

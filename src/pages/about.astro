---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="About me"
  eyebrow="A short introduction"
  description="The useful version, without inventing a grand origin story."
>
  <div class="prose-copy">
    <h2>Hello, I&rsquo;m Lianne.</h2>
    <p>
      I care about making complicated things more legible, useful, and human.
    </p>
    <p>
      This site is a growing record of selected work and ideas. The longer
      biography is still under review, so this page intentionally avoids
      carrying stale claims forward.
    </p>
  </div>
</PageLayout>

<style>
  .prose-copy {
    max-width: 700px;
  }
  .prose-copy h2 {
    margin-bottom: 26px;
  }
  .prose-copy p {
    color: var(--muted);
    font-size: 1.12rem;
  }
  .prose-copy p + p {
    margin-top: 18px;
  }
</style>

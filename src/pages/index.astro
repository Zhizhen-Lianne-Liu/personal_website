---
import ArrowLink from "@/components/ArrowLink.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/lib/urls";
---

<BaseLayout
  title="Lianne Liu"
  description="The personal website of Lianne Liu — selected work, writing, and notes on thoughtful technology."
>
  <section class="home-hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Hello, I&rsquo;m Lianne</p>
        <h1>I like making complex things feel <em>clear.</em></h1>
        <p class="hero-intro">
          This is my corner of the web for selected work, considered writing,
          and the ideas I am still figuring out.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={sitePath("/work/")}
            >Explore my work <span aria-hidden="true">→</span></a
          >
          <a class="button" href={sitePath("/about/")}>More about me</a>
        </div>
      </div>
      <div class="hero-stamp" aria-hidden="true">
        <div class="orbit"><span>Curious by default</span><b>✦</b></div>
        <div class="note-card">
          <span class="note-dot"></span>
          <p>Currently building</p>
          <strong>A better home<br />for ideas</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section work-preview">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Selected work</p><h2>Made with intent.</h2>
        </div>
        <ArrowLink href={sitePath("/work/")} label="See all work" />
      </div>
      <article class="feature-card">
        <div class="feature-visual" aria-hidden="true">
          <div class="mini-browser">
            <div class="browser-bar"><i></i><i></i><i></i></div>
            <div class="browser-body">
              <span>LL</span>
              <div><b></b><b></b><b></b></div>
            </div>
          </div>
        </div>
        <div class="feature-copy">
          <p class="card-kicker">Design & development · 2026</p>
          <h3>A personal site with fewer moving parts</h3>
          <p>
            A static, accessible home for projects and writing, designed from
            the content outward and prepared for safe SRCF deployment.
          </p>
          <ul class="tag-list">
            <li>Astro</li><li>TypeScript</li><li>Custom CSS</li>
          </ul>
          <ArrowLink
            href={sitePath("/writing/building-with-less/")}
            label="Read the build note"
          />
        </div>
      </article>
    </div>
  </section>

  <section class="section writing-preview">
    <div class="shell writing-row">
      <div>
        <p class="eyebrow">From the notebook</p>
        <h2>Thinking<br />in public.</h2>
      </div>
      <article class="note-preview">
        <p class="card-kicker">
          <time datetime="2026-08-30">30 August 2026</time> · 3 min read
        </p>
        <h3>
          <a href={sitePath("/writing/building-with-less/")}
            >Building this site with less</a>
        </h3>
        <p>
          A short note on choosing a small static stack and being deliberate
          about what gets migrated.
        </p>
        <ArrowLink href={sitePath("/writing/")} label="Browse all writing" />
      </article>
    </div>
  </section>

  <section class="contact-band">
    <div class="shell contact-inner">
      <div>
        <p class="eyebrow">Say hello</p><h2>Have an interesting idea?</h2>
      </div>
      <a
        class="round-link"
        href={sitePath("/contact/")}
        aria-label="Go to contact page"
        ><span>Let&rsquo;s talk</span><b aria-hidden="true">↗</b></a
      >
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-block: clamp(70px, 10vw, 132px);
    border-bottom: var(--line);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.65fr) minmax(280px, 0.7fr);
    gap: clamp(48px, 8vw, 110px);
    align-items: center;
  }
  .hero-copy .eyebrow {
    margin-bottom: 28px;
  }
  .hero-copy h1 em {
    position: relative;
    color: var(--coral);
    font-weight: inherit;
  }
  .hero-copy h1 em::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0.06em;
    left: 0;
    height: 0.08em;
    background: var(--ink);
    transform: rotate(-1deg);
  }
  .hero-intro {
    max-width: 680px;
    margin-top: 30px;
    color: var(--muted);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 38px;
  }
  .button {
    display: inline-flex;
    gap: 24px;
    align-items: center;
    padding: 13px 19px;
    border: var(--line);
    border-radius: 8px;
    background: var(--paper-light);
    font-weight: 800;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .button:hover {
    transform: translate(1px, 1px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .button-primary {
    background: var(--ink);
    color: var(--paper-light);
  }
  .hero-stamp {
    position: relative;
    display: grid;
    min-height: 400px;
    place-items: center;
  }
  .orbit {
    position: absolute;
    top: 10px;
    right: 0;
    display: grid;
    width: 170px;
    height: 170px;
    place-items: center;
    border: 2px dashed var(--ink);
    border-radius: 50%;
    background: var(--yellow);
    transform: rotate(8deg);
  }
  .orbit span {
    width: 100px;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .orbit b {
    position: absolute;
    right: 12px;
    bottom: 20px;
    font-size: 1.5rem;
  }
  .note-card {
    position: relative;
    z-index: 2;
    width: min(280px, 90%);
    padding: 30px;
    border: var(--line);
    border-radius: var(--radius);
    background: var(--blue);
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(-5deg);
  }
  .note-card::after {
    content: "";
    position: absolute;
    right: 24px;
    bottom: -34px;
    width: 62px;
    height: 62px;
    border: var(--line);
    border-radius: 50%;
    background: var(--coral);
  }
  .note-dot {
    display: block;
    width: 13px;
    height: 13px;
    margin-bottom: 54px;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: var(--coral);
  }
  .note-card p {
    margin-bottom: 8px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .note-card strong {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.05;
  }
  .work-preview {
    background: var(--paper-light);
  }
  .section-heading .eyebrow {
    margin-bottom: 14px;
  }
  .feature-card {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    overflow: hidden;
    border: var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: var(--shadow);
  }
  .feature-visual {
    display: grid;
    min-height: 440px;
    place-items: center;
    padding: 48px;
    border-right: var(--line);
    background: var(--green);
  }
  .mini-browser {
    width: min(500px, 100%);
    overflow: hidden;
    border: var(--line);
    border-radius: 9px;
    background: var(--paper-light);
    box-shadow: 10px 10px 0 rgb(30 30 27 / 25%);
    transform: rotate(-2deg);
  }
  .browser-bar {
    display: flex;
    gap: 7px;
    padding: 12px;
    border-bottom: var(--line);
  }
  .browser-bar i {
    width: 10px;
    height: 10px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--coral);
  }
  .browser-bar i:nth-child(2) {
    background: var(--yellow);
  }
  .browser-bar i:nth-child(3) {
    background: var(--green);
  }
  .browser-body {
    display: flex;
    min-height: 250px;
    align-items: center;
    justify-content: center;
    gap: 32px;
    padding: 30px;
  }
  .browser-body > span {
    display: grid;
    width: 92px;
    height: 92px;
    place-items: center;
    border: var(--line);
    border-radius: 50%;
    background: var(--coral);
    font-family: var(--font-display);
    font-size: 2rem;
  }
  .browser-body div {
    display: grid;
    width: 45%;
    gap: 12px;
  }
  .browser-body b {
    display: block;
    height: 16px;
    border: 1.5px solid var(--ink);
    background: var(--blue);
  }
  .browser-body b:nth-child(2) {
    width: 78%;
    background: var(--yellow);
  }
  .browser-body b:nth-child(3) {
    width: 58%;
    background: var(--green);
  }
  .feature-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(30px, 5vw, 60px);
  }
  .feature-copy h3 {
    margin-bottom: 20px;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  .feature-copy > p:not(.card-kicker) {
    margin-bottom: 26px;
    color: var(--muted);
  }
  .feature-copy .tag-list {
    margin-bottom: 28px;
  }
  .writing-preview {
    background: var(--yellow);
  }
  .writing-row {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(44px, 10vw, 140px);
    align-items: center;
  }
  .writing-row .eyebrow {
    margin-bottom: 15px;
  }
  .note-preview {
    padding: clamp(28px, 5vw, 54px);
    border: var(--line);
    border-radius: var(--radius);
    background: var(--paper-light);
    box-shadow: var(--shadow);
    transform: rotate(1deg);
  }
  .note-preview h3 {
    margin-bottom: 20px;
    font-size: clamp(2rem, 4vw, 3rem);
  }
  .note-preview > p:not(.card-kicker) {
    margin-bottom: 28px;
    color: var(--muted);
  }
  .contact-band {
    padding-block: clamp(68px, 9vw, 110px);
    background: var(--coral);
  }
  .contact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }
  .contact-inner .eyebrow {
    margin-bottom: 14px;
  }
  .round-link {
    display: grid;
    flex: 0 0 auto;
    width: 170px;
    height: 170px;
    place-items: center;
    border: var(--line);
    border-radius: 50%;
    background: var(--paper-light);
    font-weight: 850;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 180ms ease;
  }
  .round-link span {
    align-self: end;
  }
  .round-link b {
    align-self: start;
    font-size: 1.5rem;
  }
  .round-link:hover {
    transform: rotate(6deg);
  }
  @media (max-width: 850px) {
    .hero-grid,
    .feature-card,
    .writing-row {
      grid-template-columns: 1fr;
    }
    .hero-stamp {
      min-height: 330px;
    }
    .feature-visual {
      min-height: 340px;
      border-right: 0;
      border-bottom: var(--line);
    }
  }
  @media (max-width: 600px) {
    .hero-stamp {
      min-height: 300px;
    }
    .orbit {
      width: 135px;
      height: 135px;
    }
    .feature-visual {
      min-height: 270px;
      padding: 26px;
    }
    .browser-body {
      min-height: 180px;
    }
    .contact-inner {
      align-items: flex-start;
      flex-direction: column;
    }
    .round-link {
      align-self: flex-end;
      width: 135px;
      height: 135px;
    }
  }
</style>

---
import DesktopShell from "@/components/os/DesktopShell";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { sitePath } from "@/lib/urls";
---

<BaseLayout
  title="Lianne Liu"
  description="The personal website of Lianne Liu — selected work, writing, and notes on thoughtful technology."
  chrome={false}
>
  <DesktopShell client:load basePath={import.meta.env.BASE_URL} />
  <noscript>
    <section class="no-script-shell">
      <p>Welcome to Lianne&rsquo;s corner of the web.</p>
      <h1>JavaScript is off.</h1>
      <p>
        The desktop needs JavaScript for its window controls, but every section
        is still available as a normal page.
      </p>
      <nav aria-label="Site sections">
        <a href={sitePath("/work/")}>Projects</a>
        <a href={sitePath("/writing/")}>Writing</a>
        <a href={sitePath("/about/")}>About me</a>
        <a href={sitePath("/contact/")}>Say hello</a>
      </nav>
    </section>
  </noscript>
</BaseLayout>

<style>
  .no-script-shell {
    min-height: 100vh;
    padding: 10vw;
    background: var(--paper);
  }

  .no-script-shell h1 {
    margin-block: 16px;
  }

  .no-script-shell nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 32px;
  }
</style>

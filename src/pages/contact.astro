---
import PageLayout from "@/layouts/PageLayout.astro";
---

<PageLayout
  title="Say hello"
  eyebrow="Contact"
  description="The current ways to find me online."
>
  <div class="contact-card">
    <div>
      <p class="card-kicker">Elsewhere</p><h2>GitHub</h2><p>
        Code, projects, and the development history of this site.
      </p>
    </div>
    <a
      href="https://github.com/Zhizhen-Lianne-Liu"
      target="_blank"
      rel="me noreferrer">Visit GitHub <span aria-hidden="true">↗</span></a
    >
  </div>
</PageLayout>

<style>
  .contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: clamp(28px, 6vw, 64px);
    border: var(--line);
    border-radius: var(--radius);
    background: var(--blue);
    box-shadow: var(--shadow);
  }
  .contact-card h2 {
    margin-bottom: 12px;
  }
  .contact-card p {
    color: var(--muted);
  }
  .contact-card a {
    flex: none;
    padding: 12px 16px;
    border: var(--line);
    border-radius: 7px;
    background: var(--paper-light);
    box-shadow: 3px 3px 0 var(--ink);
    font-weight: 850;
    text-decoration: none;
  }
  @media (max-width: 620px) {
    .contact-card {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
